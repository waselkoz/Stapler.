# TinyKit credentials (optional)
TINYKIT_EMAIL=
TINYKIT_PASSWORD=

# API Keys — comma-separated, rotates on failure
# Get keys from https://openrouter.ai/keys
OPENROUTER_API_KEYS=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
KEY_COOLDOWN_SECONDS=60

# Groq API Key (direct, optional fallback)
GROQ_API_KEYS=gsk_your-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Playwright browser path (Windows)
PLAYWRIGHT_BROWSERS_PATH=D:\playwright_browsers

# Rate limiting
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=60

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5001
